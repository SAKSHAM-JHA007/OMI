# OMI Environment Configuration
PORT=3000

# ==========================================
# High-Speed LLM Providers
# ==========================================

# 1. DeepSeek (Ultra-fast, high intelligence, cost-effective)
# Get a key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Models: deepseek-chat (DeepSeek-V3) or deepseek-reasoner (DeepSeek-R1)
# PRIMARY_MODEL=deepseek-chat

# 2. Groq (Fastest inference engine, ~500+ tokens/sec)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
# Models: llama-3.3-70b-versatile or deepseek-r1-distill-llama-70b
# PRIMARY_MODEL=llama-3.3-70b-versatile

# 3. Google Gemini (Fast & large context)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
# PRIMARY_MODEL=gemini-1.5-flash

# 4. OpenAI
OPENAI_API_KEY=
# PRIMARY_MODEL=gpt-4o-mini

# Default fallback if no key is set ("mock" for instant zero-key offline testing)
PRIMARY_MODEL=mock

# Agent Caps & Constraints (PRD §5 & §12)
MAX_ITERATIONS=8
MAX_TOOL_CALLS=12
TOKEN_BUDGET=120000
MAX_COST_DOLLARS=0.25
WALL_CLOCK_TIMEOUT_SEC=90
FETCH_TIMEOUT_MS=15000
SEARCH_TIMEOUT_MS=4000

# CodeScene Code Health MCP (Optional)
# Get a free standalone token at: https://codescene.com/
CS_ACCESS_TOKEN=

